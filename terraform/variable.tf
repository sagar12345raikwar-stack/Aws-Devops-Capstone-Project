variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "ap-southeast-2"
}

variable "project_name" {
  description = "Project name"
  type        = string
  default     = "capstone-project"
}

variable "environment" {
  description = "Environment"
  type        = string
  default     = "dev"
}

